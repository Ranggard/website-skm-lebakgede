# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend Configuration
# Options: 'google-sheets' or 'supabase'
BACKEND_TYPE=google-sheets
NEXT_PUBLIC_BACKEND_TYPE=google-sheets

# Google Sheets Backend Configuration (if BACKEND_TYPE=google-sheets)
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/d/YOUR_SCRIPT_ID/usercontent
GOOGLE_SHEET_ID=YOUR_SHEET_ID
ADMIN_TOKEN=your_secure_admin_token_here

# Staff Login Credentials
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_admin_password

# Supabase Backend Configuration (if BACKEND_TYPE=supabase)
# Get these values from: https://app.supabase.com/project/[project-id]/settings/api
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...  # Public key (safe to expose)
SUPABASE_ANON_KEY=eyJhbGc...  # Public key copy (for compatibility)
SUPABASE_SERVICE_KEY=eyJhbGc...  # Private key - KEEP SECRET! Never commit!

# Analytics & Monitoring (optional)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_PDF_EXPORT=true
NEXT_PUBLIC_ENABLE_EXCEL_EXPORT=true
